<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig style rules (unused usings, file-scoped namespaces) fail the build, not only dotnet format -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Doc comments are compiled so a broken cref fails the build. Only non-obvious members carry comments
         (CS1591), and records document only the non-obvious parameters (CS1573). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
