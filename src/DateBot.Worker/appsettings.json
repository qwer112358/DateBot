{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "Telegram": {
    "ApiId": 0,
    "ApiHash": "",
    "PhoneNumber": "",
    "Password": "",
    "TashdateBotUsername": "Znakomstva_Tashkentt_bot",
    "SessionFile": "telegram.session"
  },

  "MiniAppClient": {
    "Url": "",
    "Language": "ru",
    "UserAgent": "",
    "Timeout": "00:00:30",
    "SessionLifetime": "00:30:00"
  },

  "Notifier": {
    "BotToken": "",
    "Verbosity": "All",
    "QuietHoursEnabled": false,
    "QuietFrom": "23:00:00",
    "QuietTo": "08:00:00",
    "TimeZone": "Asia/Tashkent"
  },

  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-haiku-5-5",
    "MaxTokens": 2048,
    "Timeout": "00:01:00"
  },

  "Storage": {
    "DataDirectory": "",
    "DatabaseFile": "datebot.db",
    "PhotosDirectory": "photos"
  },

  "Processing": {
    "Mode": "Confirm",
    "LikedMeMessage": "AfterLikeBack",
    "MutualRoute": "DirectToUser",
    "Channels": [ "Telegram", "App" ],
    "MiniApp": {
      "Enabled": true,
      "PollInterval": "00:10:00",
      "MaxLikesPerPass": 10
    },
    "LikeBackButtons": [ "❤", "👍", "Лайк", "Like", "Yoqdi" ],
    "MessageButtons": [],
    "MinPause": "00:00:05",
    "MaxPause": "00:00:30",
    "ButtonToTextPause": "00:00:03",
    "MaxActionsPerHour": 20,
    "HistoryBatchSize": 50,
    "FirstRunBackfill": "00:00:00",
    "PollInterval": "00:05:00",
    "RetentionDays": 0,
    "Filters": {
      "Enabled": false,
      "MinAge": 18,
      "MaxAge": 99,
      "Cities": [],
      "StopWords": []
    }
  },

  "Parsing": {
    "LikeMarkers": [ "понравил", "лайкнул", "yoqtir", "liked you" ],
    "MutualMarkers": [ "у вас мэтч", "мэтч с", "взаимн", "o'zaro", "o‘zaro", "mutual", "it's a match" ],
    "IgnoreMarkers": [],
    "LikeHintMarkers": [ "Тобой интересуются", "тебя лайкнули" ],
    "ProfilePatterns": [
      "мэтч с (?<name>[^!\\n]{1,64})!",
      "^(?<name>[^,\\n]{1,64}),\\s*(?<age>\\d{2})\\s*(?:,\\s*(?<city>[^\\n,–—-]{1,64}?))?\\s*(?:[–—-]\\s*(?<bio>[\\s\\S]+))?$"
    ],
    "InterestsPattern": "^(?:Интересы|Увлечения|Qiziqishlar|Interests)\\s*:\\s*(?<interests>.+)$",
    "UsernamePattern": "@(?<username>[A-Za-z][A-Za-z0-9_]{4,31})",
    "PersonIdPattern": "@(?<id>[A-Za-z][A-Za-z0-9_]{4,31})",
    "UnknownMessages": "ParseFailed"
  },

  "Replies": {
    "Owner": {
      "Name": "",
      "About": "",
      "Tone": "дружелюбный, спокойный, с лёгким юмором",
      "Avoid": "комплименты внешности, вопросы о деньгах и работе в первом сообщении"
    },
    "DefaultLanguage": "Russian",
    "MinLength": 20,
    "MaxLength": 400,
    "MaxEmoji": 1,
    "UsePhoto": true,
    "InvalidReplyPolicy": "Template",
    "Templates": {
      "Russian": [
        "Привет, {name}! Приятно, что мы совпали. Как проходит твой день?",
        "{name}, привет! Твоя анкета зацепила. Чем любишь заниматься в свободное время?"
      ],
      "Uzbek": [
        "Salom, {name}! Tanishganimizdan xursandman. Kuningiz qanday o'tyapti?",
        "Assalomu alaykum, {name}! Bo'sh vaqtingizda nima bilan shug'ullanishni yoqtirasiz?"
      ],
      "English": [
        "Hi {name}! Glad we matched. How is your day going?",
        "Hey {name}! Your profile caught my eye. What do you like to do in your free time?"
      ]
    }
  }
}
