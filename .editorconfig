root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,slnx,json,config}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

# usings: System first, no blank lines between groups, unused ones flagged in the IDE
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

csharp_style_namespace_declarations = file_scoped:warning

# EF Core migrations are generated code
[**/Migrations/*.cs]
generated_code = true
