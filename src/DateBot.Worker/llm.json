{
  // Как пишутся сообщения. Файл читается заново перед каждым сообщением: правка действует со следующего черновика,
  // перезапуск не нужен. Если правка сломала файл (ошибка в JSON, значение вне диапазона), сервис продолжает работать
  // на последних исправных настройках и пишет в лог, что не так. Тексты промптов — в prompts.md.

  // claude-haiku-5-5 — быстрая и дешёвая; claude-sonnet-5-5 — умнее и дороже; claude-opus-5-5 — самая сильная и дорогая.
  "Model": "claude-haiku-5-5",

  // Сколько модель думает перед ответом: Low, Medium, High, Xhigh, Max. Выше — дольше и дороже.
  "Effort": "Low",

  // Предел ответа модели в токенах, вместе с размышлениями: 256–16000.
  "MaxTokens": 2048,

  // Сколько фото анкеты, главное первым, получает модель: 0–10. 0 — без фото. В бот-уведомитель приходят все.
  "MaxPhotos": 10,

  // Строки анкеты, которые модель не получает, — по подписи до двоеточия. В ваших карточках они остаются.
  "HiddenFacts": [ "Цель знакомства" ],

  // Проверка готового текста: длина в символах и число эмодзи. Не прошёл — уходит шаблон ниже.
  "MinLength": 20,
  "MaxLength": 400,
  "MaxEmoji": 1,

  // Язык ответа, если язык анкеты не определился: Russian, Uzbek, English.
  "DefaultLanguage": "Russian",

  // Если текст модели не прошёл проверку: Template — уходит шаблон; Confirm — шаблон приходит вам черновиком даже в режиме Auto.
  "InvalidReplyPolicy": "Template",

  // Запасные сообщения, когда модель недоступна или её текст не прошёл проверку. {name} — имя из анкеты.
  "Templates": {
    "Russian": [
      "Привет, {name}! Приятно, что мы совпали. Как проходит твой день?",
      "{name}, привет! Твоя анкета зацепила. Чем любишь заниматься в свободное время?"
    ],
    "Uzbek": [
      "Salom, {name}! Tanishganimizdan xursandman. Kuningiz qanday o'tyapti?",
      "Assalomu alaykum, {name}! Bo'sh vaqtingizda nima bilan shug'ullanishni yoqtirasiz?"
    ],
    "English": [
      "Hi {name}! Glad we matched. How is your day going?",
      "Hey {name}! Your profile caught my eye. What do you like to do in your free time?"
    ]
  }
}
