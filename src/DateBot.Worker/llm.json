{
  // Настройки модели для экспериментов. Перекрывают appsettings.json; после правки перезапустите сервис.
  // Тексты промптов — в prompts.md, они подхватываются без перезапуска.

  "Anthropic": {
    // claude-haiku-5-5 — быстрая и дешёвая; claude-sonnet-5-5 — умнее и дороже; claude-opus-5-5 — самая сильная и дорогая.
    "Model": "claude-haiku-5-5",
    // Сколько модель думает перед ответом: Low, Medium, High, Xhigh, Max. Выше — дольше и дороже.
    "Effort": "Low",
    // Предел длины ответа модели в токенах (вместе с размышлениями): 256–16000.
    "MaxTokens": 2048
  },

  "Replies": {
    // Сколько фото анкеты, главное первым, получает модель: 0–10. 0 — без фото. В бот-уведомитель фото приходят все.
    "MaxPhotos": 10
  }
}
